# Vehicle State Service - environment example
# Copy to .env for local development.

# Networking / runtime
NODE_ENV=development
HOST=0.0.0.0
PORT=3001

# Logging
LOG_LEVEL=info
SERVICE_NAME=vehicle-state

# CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4000

# Storage (MVP)
# - memory: in-memory only (preview-safe)
# - file: persists to STATE_STORE_DIR as JSON per vehicle
STATE_STORE_DRIVER=memory
STATE_STORE_DIR=./data
STATE_MAX_HISTORY_PER_VEHICLE=1000

# WebSocket (optional real-time updates)
WS_ENABLED=true
WS_PATH=/ws

# --- Existing template/example vars (kept for compatibility with previews) ---
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
WS_URL=ws://localhost:3001/ws
SITE_URL=http://localhost:3000
